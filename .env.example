# ============================================================================
# TRANSIT BACKEND - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and customize for your environment
# ============================================================================

# ==========================================================================
# Database Configuration (PostgreSQL + TimescaleDB + PostGIS)
# ==========================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transit_poc
DB_USER=transit_user
DB_PASSWORD=transit_password

# Connection Pool Settings
# Optimized for 1000+ concurrent WebSocket connections
DB_MAX_CONNS=50
DB_MIN_CONNS=10

# ==========================================================================
# Redis Configuration
# ==========================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Pool size for Redis connections
REDIS_POOL_SIZE=50

# ==========================================================================
# Server Configuration
# ==========================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ==========================================================================
# H3 Geospatial Configuration
# ==========================================================================
# H3 hexagonal grid resolution for geofencing
# Resolution 7  = ~1.2km edge length (neighborhood scale)
# Resolution 8  = ~460m edge length (block scale)
# Resolution 9  = ~175m edge length (ideal for bus stops) ← DEFAULT
# Resolution 10 = ~66m edge length (high precision)
H3_RESOLUTION=9

# ==========================================================================
# Application Settings
# ==========================================================================
# Environment: development, staging, production
ENV=development

# Log level: debug, info, warn, error
LOG_LEVEL=debug

# ==========================================================================
# WebSocket Configuration
# ==========================================================================
# WebSocket read/write buffer sizes
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024

# Ping interval for WebSocket keep-alive (seconds)
WS_PING_INTERVAL=30

# ==========================================================================
# Docker Configuration (used by docker-compose)
# ==========================================================================
# These are injected during docker build
VERSION=dev
BUILD_TIME=
GIT_HASH=
